### Git ###
# Creado por git para copias de seguridad. Para desactivar las copias de seguridad en Git:
# $ git config --global mergetool.keepBackup false
*.orig

# Creado por git al usar herramientas de fusión para conflictos
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTO.*
*_BACKUP_*.txt
*_BASE_*.txt
*_LOCAL_*.txt
*_REMOTO_*.txt

### Linux ###
*~

# Archivos temporales que se pueden crear si un proceso aún tiene abierto un identificador de un archivo eliminado.
.fuse_hidden*

# Preferencias de directorio de KDE
.directorio

# Carpeta de papelera de Linux que puede aparecer en cualquier partición o disco
.Basura-*

# Los archivos .nfs se crean cuando se elimina un archivo abierto pero aún se está accediendo a él.
.nfs*

### macOS ###
# General
.DS_Store
.AppleDouble
.LSOverride

# El icono debe terminar con dos \r
Icono


# Miniaturas
._*

# Archivos que podrían aparecer en la raíz de un volumen
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.ElementosTemporales
.Papeleras
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directorios potencialmente creados en el recurso compartido remoto de AFP
.AppleDB
.AppleDesktop
Carpeta de papelera de red
Elementos temporales
.apdisk

### Parche para macOS ###
# Archivos generados por iCloud
*.icloud

